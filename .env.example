# ─────────────────────────────────────────────────────────
# BASE URL & DOMAIN CONFIGURATION
# ─────────────────────────────────────────────────────────
# URL domain aktif untuk produksi / deployment.
# Di Freebuff, Anda dapat mengisi BASE_URL atau NEXT_PUBLIC_BASE_URL
# di Production environment variables dashboard untuk override otomatis.
BASE_URL=https://levistream.freebuff.app
NEXT_PUBLIC_BASE_URL=https://levistream.freebuff.app

# ─────────────────────────────────────────────────────────
# TMDB (The Movie Database) API
# Daftar gratis di https://www.themoviedb.org/settings/api
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ─────────────────────────────────────────────────────────
# MONGODB DATABASE CONFIGURATION (Opsional jika pakai Mongo)
# ─────────────────────────────────────────────────────────
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=filmes_db
